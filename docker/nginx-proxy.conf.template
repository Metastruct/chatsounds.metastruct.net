# Rendered at container start by 20-make-cert.sh when BEHIND_PROXY=true, which
# substitutes __GITHUB_CLIENT_ID__.
#
# This is the shape for running behind a reverse proxy (Traefik on the
# metastruct box): the proxy terminates TLS with a real certificate, so this
# server speaks plain HTTP on 8080 and never redirects. The COOP/COEP headers
# stay, because they are what grant SharedArrayBuffer and they belong to the
# response, not to the transport.

# One sound's path, still percent-encoded, for the /s/ and /stream/ routes.
#
# nginx decodes the URI before matching a location, which is what makes the
# character classes down there a real filter: a smuggled %3C is a < by then and
# simply does not match. But the URLs those routes go on to build have to be
# encoded again, and nginx cannot encode, so the raw form is taken off
# $request_uri here. A trigger with a space in it needs both halves of this.
map $request_uri $chatsound_path {
    default "";
    "~^/(?:s|stream)/(?<encoded>[^?#]+)"  $encoded;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Embedder-Policy require-corp always;
    add_header Cross-Origin-Resource-Policy same-origin always;

    gzip on;
    gzip_types text/css text/javascript application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;

    # nginx's mime.types knows .js and .wasm but not .mjs, so onnxruntime's glue
    # module went out as application/octet-stream and the browser refused to
    # execute it: "error loading dynamically imported module". Module scripts are
    # MIME-checked strictly, so the type is not cosmetic. This block sits before
    # the /assets/ one because nginx takes the first matching regex location, and
    # it repeats the headers because a location with its own add_header does not
    # inherit the server's.
    location ~* \.mjs$ {
        types { text/javascript mjs; }
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }

    # --- GitHub sign-in ----------------------------------------------------
    # Same forwarders as the standalone config: github.com's OAuth endpoints
    # send no CORS headers, so the two device-flow calls go through this origin.
    # No secret, no state.
    location = /github/app.json {
        default_type application/json;
        return 200 '{"clientId":"__GITHUB_CLIENT_ID__"}';
    }
    resolver 127.0.0.11 ipv6=off valid=60s;

    # github.com answers these with about 4.5 KB of headers, 3.6 KB of it a
    # content-security-policy meant for its own pages. nginx's default 4 KB
    # proxy_buffer_size cannot hold that, and refuses the response with "upstream
    # sent too big header", which reaches the browser as a 502. The bodies are a
    # few hundred bytes of JSON; it is only the headers that are fat.
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    proxy_busy_buffers_size 32k;
    # None of github's own response headers mean anything on this origin, and its
    # session cookie would be dead weight in the browser's jar under our name.
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header Set-Cookie;

    location = /github/device/code {
        set $github "https://github.com";
        proxy_pass $github/login/device/code;
        proxy_ssl_server_name on;
        proxy_set_header Host github.com;
        proxy_set_header Accept application/json;
    }
    location = /github/oauth/token {
        set $github "https://github.com";
        proxy_pass $github/login/oauth/access_token;
        proxy_ssl_server_name on;
        proxy_set_header Host github.com;
        proxy_set_header Accept application/json;
    }

    # --- sharing one sound -------------------------------------------------
    # A link to raw.githubusercontent.com is the obvious way to hand someone a
    # sound and the wrong one: GitHub serves every .ogg as
    # "content-disposition: attachment", so the link downloads the file instead
    # of playing it, and a chat client has no name to put on it and no player to
    # offer. /stream/ is the same bytes without that header, and /s/ is a page
    # carrying that one sound's Open Graph tags, which is what an embed reads.
    #
    # The character classes below are the whole safety story, because $s_realm
    # and $s_name are reflected into the HTML and nginx cannot escape anything.
    # Every path in the repo is lowercase letters, digits, space and . _ - ! ( )
    # + (checked against all 38,000 of them), so nothing carrying < > " ' & or %
    # matches either location, and what does not match is never echoed. The high
    # bytes are there for the one trigger with a typographic apostrophe in it;
    # they cannot spell an HTML metacharacter, which is ASCII to a byte.
    location ~ "^/stream/[a-z0-9 ._!()+/\x80-\xff-]+\.ogg$" {
        set $raw "https://raw.githubusercontent.com";
        proxy_pass $raw/Metastruct/garrysmod-chatsounds/master/sound/chatsounds/autoadd/$chatsound_path;
        proxy_ssl_server_name on;
        proxy_set_header Host raw.githubusercontent.com;
        # The one that matters: without this the browser downloads the sound.
        proxy_hide_header Content-Disposition;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Set-Cookie;
        # GitHub sends its own versions of the three below, and add_header
        # appends rather than replaces, so without hiding them first every
        # response carries each one twice with two different values.
        proxy_hide_header Cross-Origin-Resource-Policy;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Cache-Control;
        # Being played from somewhere else is the entire point of this route, so
        # it opts out of the isolation the app pages want.
        add_header Cross-Origin-Resource-Policy cross-origin always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=86400" always;
    }

    location ~ "^/s/(?<s_realm>[a-z0-9 ._!()+\x80-\xff-]+)/(?<s_name>[a-z0-9 ._!()+/\x80-\xff-]+)\.ogg$" {
        default_type text/html;
        charset utf-8;
        # Plain HTTP in here, HTTPS at the proxy; the link has to say what the
        # world sees.
        set $public "https://$http_host";
        add_header Cache-Control "public, max-age=3600" always;
        # No COOP/COEP here: this page is one audio element and no bundle, so it
        # needs no SharedArrayBuffer, and isolation would only cost it the
        # ability to be framed by whoever the link was sent to.
        return 200 '<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark">
<title>$s_name in $s_realm - Meta Construct chatsounds</title>
<link rel="canonical" href="$public/s/$chatsound_path">
<meta name="theme-color" content="#212121">
<meta property="og:type" content="music.song">
<meta property="og:site_name" content="Meta Construct">
<meta property="og:title" content="$s_name">
<meta property="og:description" content="a chatsound in $s_realm">
<meta property="og:url" content="$public/s/$chatsound_path">
<meta property="og:audio" content="$public/stream/$chatsound_path">
<meta property="og:audio:secure_url" content="$public/stream/$chatsound_path">
<meta property="og:audio:type" content="audio/ogg">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<style>
body{margin:0;min-height:100vh;display:grid;place-items:center;background:#212121;color:#fefefe;font-family:system-ui,-apple-system,sans-serif}
main{padding:2rem;max-width:34rem;text-align:center}
.realm{margin:0;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.85rem;color:rgba(254,254,254,.5)}
h1{margin:.3rem 0 1.4rem;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:1.4rem;font-weight:600;overflow-wrap:anywhere}
audio{width:100%}
a{display:inline-block;margin-top:1.6rem;color:#09b387;font-size:.85rem}
</style>
</head>
<body>
<main>
<p class="realm">$s_realm/</p>
<h1>$s_name</h1>
<audio controls autoplay preload="auto" src="/stream/$chatsound_path"></audio>
<p><a href="/">every chatsound at Meta Construct</a></p>
</main>
</body>
</html>
';
    }

    # Hashed build assets, the font, and the VAD model never change in place.
    location ~* ^/(assets|fonts|models)/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
