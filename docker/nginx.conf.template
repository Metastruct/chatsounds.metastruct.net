# Rendered at container start by 20-make-cert.sh, which substitutes __HTTPS_PORT__
# and __GITHUB_CLIENT_ID__.

# One sound's path, still percent-encoded, for the /s/ and /stream/ routes.
#
# nginx decodes the URI before matching a location, which is what makes the
# character classes down there a real filter: a smuggled %3C is a < by then and
# simply does not match. But the URLs those routes go on to build have to be
# encoded again, and nginx cannot encode, so the raw form is taken off
# $request_uri here. A trigger with a space in it needs both halves of this.
map $request_uri $chatsound_path {
    default "";
    "~^/(?:s|stream)/(?<encoded>[^?#]+)"  $encoded;
}

# The same path pointed at the MP4 the share page embeds, since nginx cannot do
# string surgery anywhere else.
map $request_uri $chatsound_mp4 {
    default "";
    "~^/s/(?<stem>[^?#]+)\\.ogg$"  "$stem.mp4";
}

# Plain HTTP exists only to send you to HTTPS. WebGPU and SharedArrayBuffer are
# both restricted to secure contexts, so an http:// origin silently loses the GPU
# and drops WebAssembly to a single thread.
server {
    listen 8080;
    server_name _;
    return 301 https://$host:__HTTPS_PORT__$request_uri;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:4m;
    ssl_session_timeout 1h;

    # Deliberately no HSTS: this certificate is self-signed, and pinning the
    # origin to HTTPS-only would strand anyone who later moves it behind a
    # different name or a real certificate.

    root /usr/share/nginx/html;
    index index.html;

    # onnxruntime and transformers.js use multi-threaded WebAssembly, which needs
    # SharedArrayBuffer, which browsers only expose to cross-origin-isolated
    # pages. These two headers are what grant that.
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Embedder-Policy require-corp always;
    add_header Cross-Origin-Resource-Policy same-origin always;

    gzip on;
    gzip_types text/css text/javascript application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;

    # nginx's mime.types knows .js and .wasm but not .mjs, so onnxruntime's glue
    # module went out as application/octet-stream and the browser refused to
    # execute it: "error loading dynamically imported module". Module scripts are
    # MIME-checked strictly, so the type is not cosmetic. This block sits before
    # the /assets/ one because nginx takes the first matching regex location, and
    # it repeats the headers because a location with its own add_header does not
    # inherit the server's.
    location ~* \.mjs$ {
        types { text/javascript mjs; }
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }

    # --- GitHub sign-in ----------------------------------------------------
    # The device flow needs two calls to github.com, which sends no CORS
    # headers, so the page cannot make them itself. These locations forward the
    # calls verbatim: no secret (the device flow does not use one), no state,
    # nothing logged. The client id is public by definition.
    location = /github/app.json {
        default_type application/json;
        return 200 '{"clientId":"__GITHUB_CLIENT_ID__"}';
    }
    # Docker's resolver, and a variable target so nginx re-resolves github.com
    # instead of pinning whatever IP it saw at startup.
    resolver 127.0.0.11 ipv6=off valid=60s;

    # github.com answers these with about 4.5 KB of headers, 3.6 KB of it a
    # content-security-policy meant for its own pages. nginx's default 4 KB
    # proxy_buffer_size cannot hold that, and refuses the response with "upstream
    # sent too big header", which reaches the browser as a 502. The bodies are a
    # few hundred bytes of JSON; it is only the headers that are fat.
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    proxy_busy_buffers_size 32k;
    # None of github's own response headers mean anything on this origin, and its
    # session cookie would be dead weight in the browser's jar under our name.
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header Set-Cookie;

    location = /github/device/code {
        set $github "https://github.com";
        proxy_pass $github/login/device/code;
        proxy_ssl_server_name on;
        proxy_set_header Host github.com;
        proxy_set_header Accept application/json;
    }
    location = /github/oauth/token {
        set $github "https://github.com";
        proxy_pass $github/login/oauth/access_token;
        proxy_ssl_server_name on;
        proxy_set_header Host github.com;
        proxy_set_header Accept application/json;
    }

    # --- youtube ------------------------------------------------
    # The Extract tab takes a YouTube link and has an API convert it. Its
    # API answers an empty status forever unless the Referer and Origin look
    # like its own site, and its download host sends no CORS headers, so the
    # browser can call neither directly; these locations forward the two calls
    # with the headers the service expects. Mirrored by ytRoutes() in
    # frontend/vite.config.ts for development; the two change together.
    #
    # Neither is an open proxy: /yt/status takes only an 11-char video id, and
    # /yt/dl only a host inside the API's current download domain. That domain
    # is theirs to rotate, so the pattern below (and its copies in
    # vite.config.ts and frontend/src/lib/fetchMedia.ts) may need updating.
    location = /yt/status {
        if ($arg_id !~ "^[A-Za-z0-9_-]{11}$") { return 403; }
        set $mp3cow "https://api.mp3cow.com";
        proxy_pass $mp3cow/z.php$is_args$args;
        proxy_ssl_server_name on;
        proxy_set_header Host api.mp3cow.com;
        proxy_set_header Referer "https://mp3cow.com/";
        proxy_set_header Origin "https://mp3cow.com";
        proxy_set_header User-Agent "Mozilla/5.0 (X11; Linux x86_64; rv:129.0) Gecko/20100101 Firefox/129.0";
        proxy_set_header Accept "*/*";
    }
    location = /yt/dl {
        if ($arg_h !~ "^([a-z0-9-]+\.)*wejfknwejfkerf\.org$") { return 403; }
        if ($arg_i !~ "^[0-9a-f]+$") { return 403; }
        proxy_pass https://$arg_h/dl.php?id=$arg_i;
        proxy_ssl_server_name on;
        proxy_ssl_name $arg_h;
        proxy_set_header Host $arg_h;
        proxy_set_header Referer "https://mp3cow.com/";
        proxy_set_header User-Agent "Mozilla/5.0 (X11; Linux x86_64; rv:129.0) Gecko/20100101 Firefox/129.0";
        proxy_set_header Accept "*/*";
    }

    # --- sharing one sound -------------------------------------------------
    # A link to raw.githubusercontent.com is the obvious way to hand someone a
    # sound and the wrong one: GitHub serves every .ogg as
    # "content-disposition: attachment", so the link downloads the file instead
    # of playing it, and a chat client has no name to put on it and no player to
    # offer. /stream/ is the same bytes without that header, and /s/ is a page
    # carrying that one sound's Open Graph tags, which is what an embed reads.
    #
    # The character classes below are the whole safety story, because $s_realm
    # and $s_name are reflected into the HTML and nginx cannot escape anything.
    # Every path in the repo is lowercase letters, digits, space and . _ - ! ( )
    # + (checked against all 38,000 of them), so nothing carrying < > " ' & or %
    # matches either location, and what does not match is never echoed. The high
    # bytes are there for the one trigger with a typographic apostrophe in it;
    # they cannot spell an HTML metacharacter, which is ASCII to a byte.
    location ~ "^/stream/[a-z0-9 ._!()+/\x80-\xff-]+\.ogg$" {
        set $raw "https://raw.githubusercontent.com";
        proxy_pass $raw/Metastruct/garrysmod-chatsounds/master/sound/chatsounds/autoadd/$chatsound_path;
        proxy_ssl_server_name on;
        proxy_set_header Host raw.githubusercontent.com;
        # The one that matters: without this the browser downloads the sound.
        proxy_hide_header Content-Disposition;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Set-Cookie;
        # GitHub sends its own versions of the three below, and add_header
        # appends rather than replaces, so without hiding them first every
        # response carries each one twice with two different values.
        proxy_hide_header Cross-Origin-Resource-Policy;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Cache-Control;
        # Being played from somewhere else is the entire point of this route, so
        # it opts out of the isolation the app pages want.
        add_header Cross-Origin-Resource-Policy cross-origin always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=86400" always;
    }


    # Built by mp4d on the first request for a sound and kept on the volume, so
    # nginx answers every later one straight off the disk. try_files is what
    # makes that split: a hit never reaches node, and a hit is the common case.
    location ~ "^/mp4/[a-z0-9 ._!()+/\\x80-\\xff-]+\\.mp4$" {
        root /var/cache/chatsounds-mp4;
        try_files $uri @mp4d;
        add_header Cross-Origin-Resource-Policy cross-origin always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=86400" always;
    }
    location @mp4d {
        proxy_pass http://127.0.0.1:8081;
        # An encode of a long sound takes a moment, and the crawler waiting on
        # it is better served late than with a 504.
        proxy_read_timeout 120s;
        add_header Cross-Origin-Resource-Policy cross-origin always;
        add_header Access-Control-Allow-Origin "*" always;
    }

    # The Extract tab fetches direct audio/video links through mp4d, which most
    # hosts will not let this cross-origin-isolated page read itself. mp4d holds
    # the SSRF guard (private, loopback and metadata addresses refused); nginx
    # only forwards the path. Buffering off so bytes and the size flow through
    # for the progress bar, and a long timeout for a slow or large download.
    location = /fetch {
        proxy_pass http://127.0.0.1:8081;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    location ~ "^/s/(?<s_realm>[a-z0-9 ._!()+\x80-\xff-]+)/(?<s_name>[a-z0-9 ._!()+/\x80-\xff-]+)\.ogg$" {
        # An empty type table, which is not decoration: the URI ends in .ogg,
        # nginx maps that extension through mime.types to audio/ogg, and that
        # beats default_type, which only speaks when no extension matched. The
        # page then went out as HTML labelled audio, so browsers rendered a
        # broken media player and Discord saw a sound file with no tags to read.
        types { }
        default_type text/html;
        charset utf-8;
        set $public "$scheme://$http_host";
        add_header Cache-Control "public, max-age=3600" always;
        # No COOP/COEP here: this page is one audio element and no bundle, so it
        # needs no SharedArrayBuffer, and isolation would only cost it the
        # ability to be framed by whoever the link was sent to.
        #
        # The only Open Graph left is the player. A title, description and site
        # name all render as extra lines above it, and three lines of chrome
        # around a three second sound is what makes an embed take over a
        # channel. The <title> stays for the browser tab, which is a different
        # audience. og:audio is gone with them: Discord has never read it, so
        # it was decoration.
        return 200 '<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark">
<title>$s_name in $s_realm - Meta Construct chatsounds</title>
<link rel="canonical" href="$public/s/$chatsound_path">
<meta name="theme-color" content="#212121">
<meta property="og:video" content="$public/mp4/$chatsound_mp4">
<meta property="og:video:secure_url" content="$public/mp4/$chatsound_mp4">
<meta property="og:video:type" content="video/mp4">
<meta property="og:video:width" content="400">
<meta property="og:video:height" content="144">
<meta property="twitter:card" content="player">
<meta property="twitter:player:stream" content="$public/mp4/$chatsound_mp4">
<meta property="twitter:player:stream:content_type" content="video/mp4">
<meta property="twitter:player:width" content="400">
<meta property="twitter:player:height" content="144">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<style>
body{margin:0;min-height:100vh;display:grid;place-items:center;background:#212121;color:#fefefe;font-family:system-ui,-apple-system,sans-serif}
main{padding:2rem;max-width:34rem;text-align:center}
.realm{margin:0;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.85rem;color:rgba(254,254,254,.5)}
h1{margin:.3rem 0 1.4rem;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:1.4rem;font-weight:600;overflow-wrap:anywhere}
audio{width:100%}
a{display:inline-block;margin-top:1.6rem;color:#09b387;font-size:.85rem}
</style>
</head>
<body>
<main>
<p class="realm">$s_realm/</p>
<h1>$s_name</h1>
<audio controls autoplay preload="auto" src="/stream/$chatsound_path"></audio>
<p><a href="/">every chatsound at Meta Construct</a></p>
</main>
</body>
</html>
';
    }

    # Hashed build assets, the font, and the VAD model never change in place.
    location ~* ^/(assets|fonts|models)/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
